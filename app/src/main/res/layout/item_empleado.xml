<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila del listado: así se dibuja cada empleado.
     A la derecha: el tacho elimina y el lápiz modifica. También se puede tocar la tarjeta para modificar. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/calc_borde_tarjeta"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Izquierda: datos del empleado y botón para liquidar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/calc_negro"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Rocío Madrid" />

            <TextView
                android:id="@+id/tvDetalleItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/calc_domingo_texto"
                android:textSize="14sp"
                tools:text="DNI 30123456 · Categoría 2 · 6 años" />

            <!-- Abre la calculadora con la categoría y la antigüedad de este empleado. -->
            <Button
                android:id="@+id/btnLiquidar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/emp_liquidar"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Derecha: eliminar arriba y modificar abajo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnEliminar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/emp_eliminar_descripcion"
                android:padding="10dp"
                android:src="@drawable/ic_eliminar"
                app:tint="@color/calc_rojo" />

            <ImageButton
                android:id="@+id/btnEditar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/emp_editar_descripcion"
                android:padding="10dp"
                android:src="@drawable/ic_editar"
                app:tint="@color/calc_azul" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
