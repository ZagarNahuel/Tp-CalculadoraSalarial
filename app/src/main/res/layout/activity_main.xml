<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_fondo"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <View
        android:id="@+id/bandaSuperior"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/calc_azul" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:gravity="center"
                android:text="@string/login_titulo"
                android:textColor="@color/calc_azul"
                android:textSize="32sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmailLogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="40dp"
                android:autofillHints="username"
                android:background="@drawable/fondo_campo_celeste"
                android:gravity="center"
                android:hint="@string/login_hint_usuario"
                android:inputType="textEmailAddress"
                android:textColor="@color/white"
                android:textColorHint="@color/calc_hint_campo" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="40dp">

                <EditText
                    android:id="@+id/etPasswordLogin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="password"
                    android:background="@drawable/fondo_campo_celeste"
                    android:gravity="center"
                    android:hint="@string/login_hint_password"
                    android:inputType="textPassword"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/calc_hint_campo" />

                <ImageView
                    android:id="@+id/ivOjoPassword"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/comun_mostrar_password"
                    android:padding="12dp"
                    android:src="@drawable/ic_ojo_tachado" />
            </FrameLayout>

            <Button
                android:id="@+id/btnIngresar"
                android:layout_width="220dp"
                android:layout_height="55dp"
                android:text="@string/login_ingresar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="@color/calc_azul" />

            <CheckBox
                android:id="@+id/cbMantenerSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/login_mantener_sesion"
                android:textColor="@color/calc_azul"
                android:textSize="13sp"
                app:buttonTint="@color/calc_azul" />

            <Button
                android:id="@+id/btnIrARegistro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/white"
                android:text="@string/login_ir_registro"
                android:textAllCaps="false"
                android:textColor="@color/calc_azul" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
