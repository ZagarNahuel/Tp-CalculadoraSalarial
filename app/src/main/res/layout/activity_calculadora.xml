<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizCalculadora"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_fondo"
    android:orientation="vertical"
    tools:context=".CalculadoraActivity">

    <LinearLayout
        android:id="@+id/encabezadoCalc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/calc_azul"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAtras"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="@string/calc_atras"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:icon="@drawable/ic_flecha_atras"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/calc_titulo"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNombreEmpleado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Nahuel Zagar" />

        <TextView
            android:id="@+id/tvDatosEmpleado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/calc_texto_encabezado"
            android:textSize="13sp"
            tools:text="Categoría inicial · 1 año de antigüedad" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spMes"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_spinner_celeste"
                    android:paddingStart="16dp"
                    android:paddingEnd="40dp"
                    android:popupBackground="@color/white" />

                <TextView
                    android:id="@+id/tvAnio"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:background="@drawable/fondo_spinner_celeste"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="40dp"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    tools:text="2026" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/fondo_tarjeta_blanca"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:text="@string/calc_ayuda_marcas"
                    android:textColor="@color/calc_azul"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="2">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="28dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/cuadrito_leyenda_blanco" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/calc_leyenda_trabajado"
                            android:textColor="@color/calc_azul"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="0dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/cuadrito_leyenda"
                            android:backgroundTint="@color/calc_rojo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/calc_leyenda_justificada"
                            android:textColor="@color/calc_azul"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="28dp"
                        android:layout_marginBottom="0dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/cuadrito_leyenda"
                            android:backgroundTint="@color/calc_negro" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/calc_leyenda_injustificada"
                            android:textColor="@color/calc_azul"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="0dp"
                        android:layout_marginBottom="0dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/cuadrito_leyenda"
                            android:backgroundTint="@color/calc_feriado" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/calc_leyenda_feriado"
                            android:textColor="@color/calc_azul"
                            android:textSize="12sp" />
                    </LinearLayout>
</GridLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbHabilitarQ1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/calc_habilitar_q1"
                android:textColor="@color/calc_azul"
                android:textStyle="bold"
                app:buttonTint="@color/calc_azul" />

            <LinearLayout
                android:id="@+id/layoutContenedorQ1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/fondo_quincena"
                android:orientation="vertical"
                android:padding="12dp">

                <GridLayout
                    android:id="@+id/gridDiasQ1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7" />

                <TextView
                    android:id="@+id/tvResumenQ1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    tools:text="Justificadas: 0 · Injustificadas: 0"
                    android:textColor="@color/calc_azul"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etHorasExtraQ1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/fondo_campo_celeste"
                    android:gravity="center"
                    android:hint="@string/calc_horas_extra_q1"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/white"
                    android:textColorHint="@color/calc_fondo" />

                <CheckBox
                    android:id="@+id/cbApercibimientoQ1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calc_apercibimiento_q1"
                    android:textColor="@color/calc_azul"
                    app:buttonTint="@color/calc_azul" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbHabilitarQ2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/calc_habilitar_q2"
                android:textColor="@color/calc_azul"
                android:textStyle="bold"
                app:buttonTint="@color/calc_azul" />

            <LinearLayout
                android:id="@+id/layoutContenedorQ2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.35"
                android:background="@drawable/fondo_quincena"
                android:orientation="vertical"
                android:padding="12dp">

                <GridLayout
                    android:id="@+id/gridDiasQ2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7" />

                <TextView
                    android:id="@+id/tvResumenQ2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    tools:text="Justificadas: 0 · Injustificadas: 0"
                    android:textColor="@color/calc_azul"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etHorasExtraQ2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/fondo_campo_celeste"
                    android:gravity="center"
                    android:hint="@string/calc_horas_extra_q2"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/white"
                    android:textColorHint="@color/calc_fondo" />

                <CheckBox
                    android:id="@+id/cbApercibimientoQ2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calc_apercibimiento_q2"
                    android:textColor="@color/calc_azul"
                    app:buttonTint="@color/calc_azul" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvUltimoNeto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@color/calc_azul"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Último neto calculado: $ 1.234.567,00" />

        <Button
            android:id="@+id/btnCalcularRecibo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/calc_calcular"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/calc_azul" />
    </LinearLayout>

</LinearLayout>
