<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/RegistroActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".RegistroActivity">

    <!--  Franja azul superior decorativa  -->
    <View
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#005CE6" />


    <TextView
        android:id="@+id/tv.Registro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Registro"
        android:textColor="#005CE6"
        android:textSize="40sp"
        android:textStyle="bold" />

    <!--  1. Nombre y Apellido  -->
    <TextView
        android:id="@+id/tv.nombreyapellido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:text="Nombre y Apellido/s"
        android:textSize="20sp">
    </TextView>

    <EditText
        android:id="@+id/et.nombreyapellido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:textSize="20sp">
    </EditText>

    <!--  2. Mail  -->
    <TextView
        android:id="@+id/tv.email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:text="E-mail"
        android:textSize="20sp">
    </TextView>

    <EditText
        android:id="@+id/et.email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:textSize="20sp"
        android:inputType="textEmailAddress">
    </EditText>

    <!--  3. Nombre de Usuario  -->

    <TextView
        android:id="@+id/tv.nombredeusuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:text="Nombre de Usuario"
        android:textSize="20sp">
    </TextView>

    <EditText
        android:id="@+id/et.nombredeusuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:textSize="20sp">
    </EditText>

    <!--  4. Contraseña  -->
    <TextView
        android:id="@+id/tv.contraseña"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:text="Contraseña"
        android:textSize="20sp">
    </TextView>

    <EditText
        android:id="@+id/et.contraseña"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:textSize="20sp">
    </EditText>

    <!--  5. Repetir Contraseña  -->
    <TextView
        android:id="@+id/tv.repetircontrasena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:text="Repetir Contraseña"
        android:textSize="20sp">
    </TextView>

    <EditText
        android:id="@+id/et.repetircontraseña"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginHorizontal="20dp"
        android:textSize="20sp">
    </EditText>

    <!--  6. Selector de Categoría (Spinner)  -->
    <TextView
        android:id="@+id/tv.categoria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:text="Categoria"
        android:textSize="20sp">
    </TextView>

    <Spinner
        android:id="@+id/sp.categoria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:entries="@array/lista_categorias"
        android:paddingHorizontal="16dp">
    </Spinner>

    <!--  7 Años de Antigüedad (NUEVO)  -->>
    <TextView
        android:id="@+id/tv.antiguedad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:text="Antiguedad"
        android:textSize="20sp">
    </TextView>

    <EditText
        android:id="@+id/et.antiguedad"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="40dp"
        android:hint="En años"
        android:inputType="number"
        android:textSize="20sp">
    </EditText>


    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="60dp"
        android:layout_marginBottom="20dp"
        android:background="#005CE6"
        android:text="Crear Usuario"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold">


    </Button>

    <TextView
        android:id="@+id/textView.nombredeusuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:gravity="center"
        android:text="¿ya tienes una cuenta? Inicia sesión"
        android:textColor="#005CE6"
        android:textSize="15sp">