<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".empleados.ListaEmpleadosFragment">

    <!-- El espacio de abajo evita que el botón de agregar tape al último empleado. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEmpleados"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="96dp"
        tools:listitem="@layout/item_empleado" />

    <TextView
        android:id="@+id/tvListaVacia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/emp_lista_vacia"
        android:textColor="@color/calc_domingo_texto"
        android:textSize="16sp"
        android:visibility="gone" />
</FrameLayout>
