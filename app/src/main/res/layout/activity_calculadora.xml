<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizCalculadora"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_fondo"
    android:orientation="vertical"
    tools:context=".CalculadoraActivity"
    tools:ignore="HardcodedText,Autofill">

    <!-- ========================================== -->
    <!-- ENCABEZADO: título, cerrar sesión y datos  -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/encabezadoCalc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/calc_azul"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/calc_titulo"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCerrarSesion"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calc_cerrar_sesion"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDatosEmpleado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Categoría: INICIAL | Antigüedad: 0 años"
            android:textColor="@color/calc_texto_encabezado"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ========================================== -->
    <!-- CONTENIDO (se desplaza)                    -->
    <!-- ========================================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Selector de mes y año -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spMes"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_spinner_celeste"
                    android:paddingStart="12dp"
                    android:paddingEnd="36dp"
                    android:popupBackground="@color/white" />

                <!-- Al tocarlo abre el selector de año (grilla de 12 años) -->
                <TextView
                    android:id="@+id/tvAnio"
                    android:layout_width="110dp"
                    android:layout_height="48dp"
                    android:background="@drawable/fondo_spinner_celeste"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="36dp"
                    tools:text="2026"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Leyenda única para las dos quincenas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="6dp"
                android:text="@string/calc_ayuda_marcas"
                android:textColor="@color/calc_azul"
                android:textSize="12sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:columnCount="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:background="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calc_leyenda_trabajado"
                        android:textColor="@color/calc_azul"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:background="@color/calc_rojo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calc_leyenda_justificada"
                        android:textColor="@color/calc_azul"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:background="@color/calc_domingo_fondo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calc_leyenda_domingo"
                        android:textColor="@color/calc_azul"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:background="@color/calc_negro" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calc_leyenda_injustificada"
                        android:textColor="@color/calc_azul"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnSpan="2"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:background="@color/calc_feriado" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calc_leyenda_feriado"
                        android:textColor="@color/calc_azul"
                        android:textSize="12sp" />
                </LinearLayout>
            </GridLayout>

            <!-- ========================================== -->
            <!-- QUINCENA 1 (días 1 al 15)                  -->
            <!-- ========================================== -->
            <CheckBox
                android:id="@+id/cbHabilitarQ1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/calc_habilitar_q1"
                android:textColor="@color/calc_azul"
                android:textStyle="bold"
                app:buttonTint="@color/calc_azul" />

            <LinearLayout
                android:id="@+id/layoutContenedorQ1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@color/calc_contenedor"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Los días se generan por código (CalculadoraActivity) -->
                <GridLayout
                    android:id="@+id/gridDiasQ1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7" />

                <TextView
                    android:id="@+id/tvResumenQ1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    tools:text="Justificadas: 0 · Injustificadas: 0"
                    android:textColor="@color/calc_azul"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etHorasExtraQ1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/fondo_campo_celeste"
                    android:gravity="center"
                    android:hint="@string/calc_horas_extra_q1"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/white"
                    android:textColorHint="@color/calc_fondo" />

                <CheckBox
                    android:id="@+id/cbApercibimientoQ1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calc_apercibimiento_q1"
                    android:textColor="@color/calc_azul"
                    app:buttonTint="@color/calc_azul" />
            </LinearLayout>

            <!-- ========================================== -->
            <!-- QUINCENA 2 (día 16 hasta fin de mes)       -->
            <!-- ========================================== -->
            <CheckBox
                android:id="@+id/cbHabilitarQ2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/calc_habilitar_q2"
                android:textColor="@color/calc_azul"
                android:textStyle="bold"
                app:buttonTint="@color/calc_azul" />

            <LinearLayout
                android:id="@+id/layoutContenedorQ2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.35"
                android:background="@color/calc_contenedor"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Los días se generan por código (CalculadoraActivity) -->
                <GridLayout
                    android:id="@+id/gridDiasQ2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7" />

                <TextView
                    android:id="@+id/tvResumenQ2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    tools:text="Justificadas: 0 · Injustificadas: 0"
                    android:textColor="@color/calc_azul"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etHorasExtraQ2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/fondo_campo_celeste"
                    android:gravity="center"
                    android:hint="@string/calc_horas_extra_q2"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/white"
                    android:textColorHint="@color/calc_fondo" />

                <CheckBox
                    android:id="@+id/cbApercibimientoQ2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calc_apercibimiento_q2"
                    android:textColor="@color/calc_azul"
                    app:buttonTint="@color/calc_azul" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ========================================== -->
    <!-- BARRA INFERIOR FIJA                        -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvUltimoNeto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@color/calc_azul"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Último neto calculado: $ 1.234.567,00" />

        <Button
            android:id="@+id/btnCalcularRecibo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/calc_calcular"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/calc_azul" />
    </LinearLayout>

</LinearLayout>