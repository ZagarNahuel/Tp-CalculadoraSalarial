<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="300dp"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/tvRangoAnios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2020 - 2031"
            android:textColor="@color/calc_negro"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnAniosAnterior"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Años anteriores"
            android:minWidth="48dp"
            android:text="‹"
            android:textColor="@color/calc_azul"
            android:textSize="24sp" />

        <Button
            android:id="@+id/btnAniosSiguiente"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Años siguientes"
            android:minWidth="48dp"
            android:text="›"
            android:textColor="@color/calc_azul"
            android:textSize="24sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="@color/calc_contenedor" />

    <GridLayout
        android:id="@+id/gridAnios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4" />
</LinearLayout>
